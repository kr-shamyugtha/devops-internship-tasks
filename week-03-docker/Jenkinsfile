pipeline {
    agent any

    environment {
        AWS_REGION = "eu-north-1"
        ACCOUNT_ID = "084000526798"
        ECR_REPO = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/myapp"
        IMAGE_TAG = "${BUILD_NUMBER}"
        APP_SERVER = "ubuntu@13.51.197.156"
    }

    stages {

        

        stage('Validate Environment') {
            steps {
                sh 'git --version'
                sh 'docker --version'
                sh 'aws --version'
                sh 'node -v || true'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('week-03-docker') {
                    sh 'npm ci || true'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('week-03-docker') {
                    sh 'npm test || true'
                }
            }
        }

        stage('Verify Project Files') {
            steps {
                dir('week-03-docker') {
                    sh 'ls -la'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('week-03-docker') {
                    sh "docker build -t myapp:${IMAGE_TAG} ."
                }
            }
        }

        stage('Verify Docker Image') {
            steps {
                sh 'docker images'
            }
        }

        stage('Login to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION | \
                docker login --username AWS --password-stdin $ECR_REPO
                '''
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh """
                docker tag myapp:${IMAGE_TAG} ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Push to ECR') {
            steps {
                sh """
                docker push ${ECR_REPO}:${IMAGE_TAG}
                """
            }
        }

        stage('Deploy to App EC2') {
            steps {
                sh """
                ssh -o StrictHostKeyChecking=no $APP_SERVER '
                docker pull ${ECR_REPO}:${IMAGE_TAG} &&
                docker stop myapp || true &&
                docker rm myapp || true &&
                docker run -d -p 80:3000 --name myapp ${ECR_REPO}:${IMAGE_TAG}
                '
                """
            }
        }
    }

    post {
        success {
            echo '✅ Application deployed successfully!'
        }
        failure {
            echo '❌ Pipeline failed. Check logs.'
        }
        always {
            sh 'docker system prune -f || true'
            echo '🧹 Cleanup completed'
        }
    }
}